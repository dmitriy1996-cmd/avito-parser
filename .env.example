# ─────────────────────────────────────────────────────────────
# Avito Scraper — environment configuration
# Copy this file to ".env" and fill in your real values.
# ─────────────────────────────────────────────────────────────

# Concurrency: number of browser contexts running in parallel.
CONCURRENCY=5

# Max retry attempts per URL (timeouts, 403/429, proxy/captcha failures).
MAX_RETRIES=3

# Run the browser without a visible window (true/false).
# IMPORTANT: Avito blocks headless — use false (headful) for Avito.
HEADLESS=false

# Per-page navigation timeout in milliseconds.
NAV_TIMEOUT_MS=60000

# Randomized human delay window (milliseconds).
MIN_DELAY_MS=2000
MAX_DELAY_MS=6000

# Where to write results.
OUTPUT_FILE=results.json

# ─────────────────────────────────────────────────────────────
# Keyword-search mode (optional; CLI flags override these).
# Avito requires a CATEGORY slug in the path for search to render.
#   node src/index.js --search "игровой ноутбук" --category noutbuki --max 30
# ─────────────────────────────────────────────────────────────
SEARCH_QUERY=
SEARCH_REGION=all
SEARCH_CATEGORY=noutbuki
MAX_ITEMS=50
MAX_PAGES=5

# ─────────────────────────────────────────────────────────────
# 2Captcha — solves Avito's firewall hCaptcha challenge.
# Without a key, the scraper fails gracefully on captcha pages.
# With a key, it clicks "Продолжить", solves the hCaptcha, and continues.
# ─────────────────────────────────────────────────────────────
TWOCAPTCHA_API_KEY=
CAPTCHA_TIMEOUT_MS=180000
AVITO_HCAPTCHA_SITEKEY=070db171-ddb9-4c93-b7f6-d25d3c9d7e28

# ─────────────────────────────────────────────────────────────
# Proxy configuration — NodeMaven residential proxies (https://nodemaven.com)
#
# PROXY_LIST accepts two formats (comma- or newline-separated):
#   1. Full URL:   socks5://user:pass@host:port   (or http://, https://)
#   2. Colon form: host:port:username:password
#
# SOCKS5 with auth is supported: Chromium can't authenticate SOCKS itself,
# so the scraper auto-spins a local HTTP->SOCKS bridge (proxy-chain) per
# context. HTTP/HTTPS proxies are used by Playwright natively.
#
# IMPORTANT for Avito: use a RUSSIAN exit IP (NodeMaven "-country-ru").
# Foreign IPs are rate-limited / firewalled almost immediately.
# ─────────────────────────────────────────────────────────────

# NodeMaven SOCKS5 (recommended). List one or more, comma/newline-separated.
# PROXY_LIST=socks5://USER-country-ru-sid-XXXX-filter-high:PASS@gate.nodemaven.com:1080
PROXY_LIST=

# Optional single-gateway form (used only if PROXY_LIST is empty).
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=

# Default protocol for "host:port:user:pass" entries that omit a scheme.
PROXY_PROTOCOL=socks5

# Sticky-session token. If it already appears inside the username
# (NodeMaven uses "-sid-"), its value is replaced per context so every
# browser context gets a distinct exit IP.
SESSION_TOKEN=-sid-
